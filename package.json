{
	"name": "tasknest",
	"version": "0.1.0",
	"description": "TaskNest: a home for tasks and memory — AI-first local task CLI for developers and coding agents",
	"private": true,
	"type": "module",
	"bin": {
		"tasknest": "./src/index.ts"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"packageManager": "bun@1.3.0",
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"start": "bun run src/index.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --fix",
		"lint:check": "eslint .",
		"test": "bun test",
		"build": "bun build src/index.ts --compile --outfile dist/tasknest"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/bun": "~1.3.0",
		"eslint": "^9.39.4",
		"globals": "^17.4.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.56.1"
	}
}
